{
    "version": 2,
    "builds": [
      {
        "src": "index.html",
        "use": "@vercel/static"
      },
      {
        "src": "style.css",
        "use": "@vercel/static"
      },
      {
        "src": "app.js",
        "use": "@vercel/static"
      },
      {
        "src": "modules/*.js",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/style.css",
        "dest": "/style.css"
      },
      {
        "src": "/app.js",
        "dest": "/app.js"
      },
      {
        "src": "/modules/(.*)",
        "dest": "/modules/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }